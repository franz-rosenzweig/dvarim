# Android: the signing key is the app's identity and cannot be replaced, so it
# must never reach git. The rest is what `bubblewrap init` and `build` generate.
android/*.keystore
android/*.jks
android/*.apk
android/*.aab
android/app/
android/build/
android/build.gradle
android/settings.gradle
android/gradle.properties
android/manifest-checksum.txt
android/store_icon.png
android/*.idsig
android/.gradle/
android/gradle/
android/gradlew*
android/local.properties

# The signing passwords. The keystore itself is already ignored above.
android/keystore.properties
