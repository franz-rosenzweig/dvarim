# Copy to keystore.properties (which git ignores) and fill in the passwords.
#
# With this file present, ./shell/release.sh signs the APK straight from Gradle
# and no password is ever typed or printed. Without it the build still works and
# leaves the APK unsigned, so nothing here is required to compile.
#
# storeFile is relative to android/. keyPassword defaults to storePassword,
# which is how the key was made — one answer, not two to get out of step.
storeFile=android.keystore
keyAlias=dvarim
storePassword=
keyPassword=
