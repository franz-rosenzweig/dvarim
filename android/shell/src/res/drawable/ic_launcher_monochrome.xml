<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer, for Android 13's "Themed icons" setting: the mark
     alone, with no colour of its own, so the launcher can tint it to match the
     wallpaper the way the system apps do.

     The viewport is the 512 of frontend/public/icons/icon.svg, so the geometry
     below is the same rounded square and check, copied across unchanged. At
     108dp that puts the mark inside the safe zone an adaptive icon has to keep
     its content in. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="512" android:viewportHeight="512">
    <path android:pathData="M176,112 H336 A64,64 0 0 1 400,176 V336 A64,64 0 0 1 336,400 H176 A64,64 0 0 1 112,336 V176 A64,64 0 0 1 176,112 Z"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="30" />
    <path android:pathData="M176,262 L234,320 L342,196"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="38"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
