<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card. The radius matches what One UI and Pixel launchers use
     for their own widgets, so it sits in the grid rather than on it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widgetBg" />
    <corners android:radius="20dp" />
</shape>
